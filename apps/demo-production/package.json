{
  "name": "@parama-dev/demo-production",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5002",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "json-server": "json-server -p 4000 --watch db.json",
    "json-server:watch": "nodemon --watch db.json --ext json --exec \"json-server -p 4000 --watch db.json\"",
    "dev:all": "concurrently -n server,app -c magenta,cyan \"npm:json-server:watch\" \"npm:dev\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@parama-dev/form-builder-core": "workspace:*",
    "@parama-dev/form-builder-editor": "workspace:*",
    "@parama-dev/form-builder-renderer": "workspace:*",
    "@parama-dev/form-builder-types": "workspace:*",
    "@parama-ui/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "json-server": "1.0.0-beta.3",
    "lucide-react": "^0.510.0",
    "radix-ui": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",

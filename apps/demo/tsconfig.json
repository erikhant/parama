{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Bundler",
    "composite": false,
    "esModuleInterop": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@parama-dev/form-builder-*": ["../../packages/*/src"],
      "@parama-dev/form-builder-core": ["../../packages/core/src"],
      "@parama-dev/form-builder-editor": ["../../packages/editor/src"],
      "@parama-dev/form-builder-renderer": ["../../packages/renderer/src"],
      "@parama-dev/form-builder-types": ["../../packages/types/src"],
      "@parama-ui/react": ["../../packages/parama-ui/src"],
      // Aliasing the packages to their sources pulls parama-ui's own files into
      // this program, and those use an internal `@/` alias. Without it every
      // component fails to resolve `@/lib/utils`, and the resulting broken
      // dependency graph surfaces as errors on the imports in src/index.tsx.
      "@/*": ["../../packages/parama-ui/src/*"]
    }
  },
  // The shared asset declarations cover parama-ui's `.svg` imports. Its own
  // `vite-env.d.ts` is not in this program, so the reference has to come from
  // here.
  "include": ["src/**/*", "../../types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
